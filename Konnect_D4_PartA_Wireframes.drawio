"geometry"/></mxCell><mxCell id="c254" value="choose again" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#000000;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.7;exitY=0;entryX=0.7;entryY=1;" edge="1" parent="1" source="c185" target="c39"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c255" value="above the line" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#000000;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.3;exitY=1;entryX=0.3;entryY=0;" edge="1" parent="1" source="c61" target="c205"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c256" value="check again" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#000000;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.7;exitY=0;entryX=0.7;entryY=1;" edge="1" parent="1" source="c205" target="c61"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c257" value="&#x27;Is this normal?&#x27; (any screen)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#000000;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;dashed=1;" edge="1" parent="1" source="c100" target="c224"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c258" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;fontColor=#FFFFFF;fontSize=9;fontStyle=1;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="526" y="248" width="20" height="20" as="geometry"/></mxCell><mxCell id="c259" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;fontColor=#FFFFFF;fontSize=9;fontStyle=1;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="816" y="325" width="20" height="20" as="geometry"/></mxCell><mxCell id="c260" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;fontColor=#FFFFFF;fontSize=9;fontStyle=1;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="816" y="390" width="20" height="20" as="geometry"/></mxCell><mxCell id="c261" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;fontColor=#FFFFFF;fontSize=9;fontStyle=1;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1396" y="295" width="20" height="20" as="geometry"/></mxCell><mxCell id="c262" value="5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;fontColor=#FFFFFF;fontSize=9;fontStyle=1;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="236" y="190" width="20" height="20" as="geometry"/></mxCell><mxCell id="c263" value="6" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;fontColor=#FFFFFF;fontSize=9;fontStyle=1;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="816" y="456" width="20" height="20" as="geometry"/></mxCell><mxCell id="c264" value="Annotations: visual hierarchy and Gestalt principles" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="1090" width="900" height="26" as="geometry"/></mxCell><mxCell id="c265" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;fontColor=#FFFFFF;fontSize=9;fontStyle=1;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="1134" width="20" height="20" as="geometry"/></mxCell><mxCell id="c266" value="Figure–ground (Gestalt): the ring and label sit on top of the camera view as the figure; the camera image is the ground. The part the step names is the only outlined thing on screen." style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#FFFFFF;strokeColor=#000000;fontSize=9;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="70" y="1130" width="960" height="58" as="geometry"/></mxCell><mxCell id="c267" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;fontColor=#FFFFFF;fontSize=9;fontStyle=1;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1060" y="1134" width="20" height="20" as="geometry"/></mxCell><mxCell id="c268" value="Proximity (Gestalt): each part label is placed directly under the part it names (MAIN WASH under the left compartment), so the label is read as belonging to that part." style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#FFFFFF;strokeColor=#000000;fontSize=9;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1090" y="1130" width="960" height="58" as="geometry"/></mxCell><mxCell id="c269" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;fontColor=#FFFFFF;fontSize=9;fontStyle=1;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="1204" width="20" height="20" as="geometry"/></mxCell><mxCell id="c270" value="Similarity (Gestalt): every ‘Normal’ explanation and every success message use the same tag/box style, and every error uses the same heavy-bordered box, so users learn one look per meaning." style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#FFFFFF;strokeColor=#000000;fontSize=9;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="70" y="1200" width="960" height="58" as="geometry"/></mxCell><mxCell id="c271" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;fontColor=#FFFFFF;fontSize=9;fontStyle=1;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1060" y="1204" width="20" height="20" as="geometry"/></mxCell><mxCell id="c272" value="Common region (Gestalt): the step number, title, instruction and camera view sit in one region; caution and status boxes are separate regions below, so warnings are not mixed into steps (T5)." style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#FFFFFF;strokeColor=#000000;fontSize=9;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1090" y="1200" width="960" height="58" as="geometry"/></mxCell><mxCell id="c273" value="5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;fontColor=#FFFFFF;fontSize=9;fontStyle=1;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="1274" width="20" height="20" as="geometry"/></mxCell><mxCell id="c274" value="Visual hierarchy: step title is the largest text → instruction → camera view → caution → status → Back/Next. Primary action is the only filled button; Next stays disabled until the step is done." style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#FFFFFF;strokeColor=#000000;fontSize=9;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="70" y="1270" width="960" height="58" as="geometry"/></mxCell><mxCell id="c275" value="6" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;fontColor=#FFFFFF;fontSize=9;fontStyle=1;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1060" y="1274" width="20" height="20" as="geometry"/></mxCell><mxCell id="c276" value="Hierarchy for errors: error boxes appear directly below the choice that caused them and before Back/Next, with the recovery action inside the box (Try again / Choose again / Check again)." style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#FFFFFF;strokeColor=#000000;fontSize=9;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1090" y="1270" width="960" height="58" as="geometry"/></mxCell><mxCell id="c277" value="Konnect D4 Part A — grayscale wireframe flow: First wash on Panasonic NA-F135A1 (core task, alternate and error paths)" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1800" height="30" as="geometry"/></mxCell><mxCell id="c278" value="Solid arrows = user navigation. Row 1 = core task (vertical slice). Row 2 = alternate/error paths and the global ‘Is this normal?’ dialog (dashed = reachable from every screen). Grayscale only: structure, not appearance." style="text;html=1;whiteSpace=wrap;fontSize=8;align=left;verticalAlign=top;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="1800" height="14" as="geometry"/></mxCell><mxCell id="p1" value="Row 3: live-camera tap-to-place (added after D4 build; grayscale)" style="text;html=1;fontSize=14;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="1410" width="700" height="24" as="geometry"/></mxCell><mxCell id="p2" value="P1 Placing (from W2, live camera only)" style="text;html=1;fontSize=12;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="330" y="1454" width="280" height="20" as="geometry"/></mxCell><mxCell id="p3" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#222222;strokeWidth=2;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="330" y="1480" width="210" height="380" as="geometry"/></mxCell><mxCell id="p4" value="Konnect   [اردو]  [Is this normal?]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E0E0E0;strokeColor=#888888;fontSize=9;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="338" y="1490" width="194" height="22" as="geometry"/></mxCell><mxCell id="p5" value="Step 1 of 6" style="text;html=1;whiteSpace=wrap;fontSize=9;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="340" y="1518" width="190" height="14" as="geometry"/></mxCell><mxCell id="p6" value="Find the detergent tray" style="text;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="340" y="1532" width="190" height="20" as="geometry"/></mxCell><mxCell id="p7" value="Lift the lid. Tray is inside the lid, on the left." style="text;html=1;whiteSpace=wrap;fontSize=9;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="340" y="1554" width="190" height="36" as="geometry"/></mxCell><mxCell id="p8" value="camera view (live)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BDBDBD;strokeColor=#555555;fontSize=9;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="340" y="1594" width="190" height="120" as="geometry"/></mxCell><mxCell id="p9" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#FFFFFF;strokeWidth=3;dashed=1;" vertex="1" parent="1"><mxGeometry x="360" y="1610" width="100" height="40" as="geometry"/></mxCell><mxCell id="p10" value="+" style="text;html=1;fontSize=16;fontStyle=1;align=center;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="400" y="1616" width="20" height="24" as="geometry"/></mxCell><mxCell id="p11" value="i  Tap the detergent tray on the camera view to place the ring. Keyboard: arrows, then Enter." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#555555;fontSize=9;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="340" y="1720" width="190" height="48" as="geometry"/></mxCell><mxCell id="p12" value="Place ring at the marked spot" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#222222;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="340" y="1772" width="190" height="30" as="geometry"/></mxCell><mxCell id="p13" value="Back" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#222222;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="340" y="1808" width="90" height="36" as="geometry"/></mxCell><mxCell id="p14" value="Next" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#E6E6E6;strokeColor=#BBBBBB;fontColor=#888888;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="440" y="1808" width="90" height="36" as="geometry"/></mxCell><mxCell id="p15" value="P2 Checking (0.7 s) - fails to E1" style="text;html=1;fontSize=12;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="620" y="1454" width="280" height="20" as="geometry"/></mxCell><mxCell id="p16" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#222222;strokeWidth=2;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="620" y="1480" width="210" height="380" as="geometry"/></mxCell><mxCell id="p17" value="Konnect   [اردو]  [Is this normal?]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E0E0E0;strokeColor=#888888;fontSize=9;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="628" y="1490" width="194" height="22" as="geometry"/></mxCell><mxCell id="p18" value="Step 1 of 6" style="text;html=1;whiteSpace=wrap;fontSize=9;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="630" y="1518" width="190" height="14" as="geometry"/></mxCell><mxCell id="p19" value="Find the detergent tray" style="text;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="630" y="1532" width="190" height="20" as="geometry"/></mxCell><mxCell id="p20" value="Lift the lid. Tray is inside the lid, on the left." style="text;html=1;whiteSpace=wrap;fontSize=9;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="630" y="1554" width="190" height="36" as="geometry"/></mxCell><mxCell id="p21" value="camera view (live)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BDBDBD;strokeColor=#555555;fontSize=9;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="630" y="1594" width="190" height="120" as="geometry"/></mxCell><mxCell id="p22" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#FFFFFF;strokeWidth=3;dashed=1;" vertex="1" parent="1"><mxGeometry x="650" y="1610" width="100" height="40" as="geometry"/></mxCell><mxCell id="p23" value="+" style="text;html=1;fontSize=16;fontStyle=1;align=center;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="690" y="1616" width="20" height="24" as="geometry"/></mxCell><mxCell id="p24" value="...  Checking the detergent tray…" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#555555;fontSize=9;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="630" y="1720" width="190" height="48" as="geometry"/></mxCell><mxCell id="p25" value="Back" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#222222;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="630" y="1808" width="90" height="36" as="geometry"/></mxCell><mxCell id="p26" value="Next" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#E6E6E6;strokeColor=#BBBBBB;fontColor=#888888;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="730" y="1808" width="90" height="36" as="geometry"/></mxCell><mxCell id="p27" value="P3 Found (ring stays with the part)" style="text;html=1;fontSize=12;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="910" y="1454" width="280" height="20" as="geometry"/></mxCell><mxCell id="p28" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#222222;strokeWidth=2;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="910" y="1480" width="210" height="380" as="geometry"/></mxCell><mxCell id="p29" value="Konnect   [اردو]  [Is this normal?]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E0E0E0;strokeColor=#888888;fontSize=9;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="918" y="1490" width="194" height="22" as="geometry"/></mxCell><mxCell id="p30" value="Step 1 of 6" style="text;html=1;whiteSpace=wrap;fontSize=9;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="920" y="1518" width="190" height="14" as="geometry"/></mxCell><mxCell id="p31" value="Find the detergent tray" style="text;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="920" y="1532" width="190" height="20" as="geometry"/></mxCell><mxCell id="p32" value="Lift the lid. Tray is inside the lid, on the left." style="text;html=1;whiteSpace=wrap;fontSize=9;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="920" y="1554" width="190" height="36" as="geometry"/></mxCell><mxCell id="p33" value="camera view (live)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BDBDBD;strokeColor=#555555;fontSize=9;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="920" y="1594" width="190" height="120" as="geometry"/></mxCell><mxCell id="p34" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#FFFFFF;strokeWidth=3;dashed=1;" vertex="1" parent="1"><mxGeometry x="940" y="1610" width="100" height="40" as="geometry"/></mxCell><mxCell id="p35" value="+" style="text;html=1;fontSize=16;fontStyle=1;align=center;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="980" y="1616" width="20" height="24" as="geometry"/></mxCell><mxCell id="p36" value="✓  Found the detergent tray. It is ringed in the view." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#555555;fontSize=9;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="920" y="1720" width="190" height="48" as="geometry"/></mxCell><mxCell id="p37" value="Move ring" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#222222;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="920" y="1772" width="100" height="30" as="geometry"/></mxCell><mxCell id="p38" value="Back" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#222222;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="920" y="1808" width="90" height="36" as="geometry"/></mxCell><mxCell id="p39" value="Next" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#444444;strokeColor=#222222;fontColor=#FFFFFF;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1020" y="1808" width="90" height="36" as="geometry"/></mxCell><mxCell id="p40" value="Annotations (continue the numbering of the Gestalt table)" style="text;html=1;fontSize=12;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="1200" y="1480" width="600" height="20" as="geometry"/></mxCell><mxCell id="p41" value="7  Signifier (Norman): dashed ring + crosshair on the camera view say 'tap here'. The camera view takes the tap directly." style="text;html=1;whiteSpace=wrap;fontSize=10;align=left;verticalAlign=top;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1200" y="1508" width="620" height="44" as="geometry"/></mxCell><mxCell id="p42" value="8  Feedback: P2 'Checking…' appears at once so the tap never feels ignored. The result is announced to screen readers." style="text;html=1;whiteSpace=wrap;fontSize=10;align=left;verticalAlign=top;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1200" y="1556" width="620" height="44" as="geometry"/></mxCell><mxCell id="p43" value="9  Constraint: Next stays disabled in P1 and P2; it enables only in P3." style="text;html=1;whiteSpace=wrap;fontSize=10;align=left;verticalAlign=top;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1200" y="1604" width="620" height="44" as="geometry"/></mxCell><mxCell id="p44" value="10 Non-pointer path: focus the camera view, move with arrow keys, Enter places. Or press 'Place ring at the marked spot'." style="text;html=1;whiteSpace=wrap;fontSize=10;align=left;verticalAlign=top;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1200" y="1652" width="620" height="44" as="geometry"/></mxCell><mxCell id="p45" value="11 Common region and proximity: the status box sits directly under the camera view it refers to." style="text;html=1;whiteSpace=wrap;fontSize=10;align=left;verticalAlign=top;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1200" y="1700" width="620" height="44" as="geometry"/></mxCell><mxCell id="p46" value="12 Recovery: if the check fails (facilitator 'Make next check fail') P2 → E1 (error a) with Try again / Show a drawing. 'Move ring' on P3 returns to P1." style="text;html=1;whiteSpace=wrap;fontSize=10;align=left;verticalAlign=top;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1200" y="1748" width="620" height="44" as="geometry"/></mxCell><mxCell id="p47" value="Drawing mode skips P1 and P2: positions are exact, recognition is a 2 s timer." style="text;html=1;whiteSpace=wrap;fontSize=10;align=left;verticalAlign=top;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1200" y="1796" width="620" height="44" as="geometry"/></mxCell><mxCell id="p48" value="tap / Enter" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#000000;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p3" target="p16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p49" value="found" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#000000;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p16" target="p28"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>